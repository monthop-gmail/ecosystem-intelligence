# คัดลอกเป็น .env แล้วแก้ตามเครื่อง — make up จะอ่านไฟล์นี้
POSTGRES_USER=ecosystem
POSTGRES_PASSWORD=ecosystem
POSTGRES_DB=ecosystem
POSTGRES_PORT=55434

# DSN ที่ทุกเครื่องมือในโปรเจกต์ใช้
ECOSYSTEM_DSN=postgresql://ecosystem:ecosystem@localhost:55434/ecosystem

# ── Team Advisor (M2) ────────────────────────────────────────────────
# claude | chatgpt | offline   (default: offline — ไม่เรียกเน็ต ไม่ต้องมี key)
ECOSYSTEM_LLM_PROVIDER=offline

# ใช้เมื่อ provider=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ECOSYSTEM_ANTHROPIC_MODEL=claude-opus-5

# ใช้เมื่อ provider=chatgpt — ไม่มี default ต้องตั้งเอง
# OPENAI_API_KEY=sk-...
# ECOSYSTEM_OPENAI_MODEL=
